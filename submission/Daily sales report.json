    {
      "parameters": {
        "jsCode": "const existing = $input.first().json.data;\n\n// Get the report we calculated earlier\nconst newReport = $('Add the day up').first().json;\n\n// See whether this date already exists\nconst alreadyExists = existing.some(\n  report => report.date === newReport.date\n);\n\nreturn [{\n  json: {\n    ...newReport,\n    alreadyExists\n  }\n}];"
      },
