    {
      "parameters": {
        "jsCode": "// requested report date\nconst date = $input.first().json.body.date;\n\n// Kuala Lumpur is UTC+8.\n// 00:00 in Kuala Lumpur = 16:00 UTC on the previous day.\nconst localMidnight = new Date(`${date}T00:00:00+08:00`);\n\n// Convert the start and end of kl to UTC+8\nconst from = localMidnight.toISOString();\nconst to = new Date(\n  localMidnight.getTime() + 24 * 60 * 60 * 1000\n).toISOString();\n\nreturn [{\n  json: {\n    date,\n    from,\n    to\n  }\n}];"
      },
      "id": "6249e4bf-24b8-4cfd-ba8e-a96dafffa228",
      "name": "Work out the day",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "url": "=http://mock-api:4100/orders",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $('Work out the day').first().json.from }}"
            },
            {
              "name": "to",
              "value": "={{ $('Work out the day').first().json.to }}"
            },
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "per_page",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "923f96e6-11a9-4307-b007-71b1a41d5602",
      "name": "Get the orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "const pages = $input.all();\n\n// Combine all orders from all pages\nconst orders = [];\n\nfor (const page of pages) {\n  orders.push(...page.json.data);\n}\n\n// Get exchange rates from the earlier rates node\nconst rates = $('get rates1').first().json.rates;\n\nlet totalMyr = 0;\n\nfor (const order of orders) {\n  const rate = rates[order.currency];\n\n  if (rate === undefined) {\n    throw new Error(`Missing exchange rate for ${order.currency}`);\n  }\n\n  totalMyr += order.amount * rate;\n}\n\n// Get original requested date\nconst date = $('Work out the day').first().json.date;\n\nreturn [{\n  json: {\n    date,\n    order_count: orders.length,\n    total_myr: Math.round(totalMyr * 100) / 100\n  }\n}];"
      },
      "id": "986e2f58-4c2d-4be2-b26b-059077e7217f",
      "name": "Add the day up",
      "type": "n8n-nodes-base.code",
