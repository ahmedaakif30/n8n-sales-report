      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst day = $('Work out the day').first().json;\n\nconst pages = [];\n\nfor (let page = 1; page <= response.total_pages; page++) {\n  pages.push({\n    json: {\n      page,\n      from: day.from,\n      to: day.to\n    }\n  });\n}\n\nreturn pages;"
      },
