      "name": "mark filled"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Try to recover the failed date from the error text\nlet failedDate = null;\n\nif (input.error?.message) {\n  const match = input.error.message.match(/\\d{4}-\\d{2}-\\d{2}/);\n  if (match) {\n    failedDate = match[0];\n  }\n}\n\nreturn [{\n  json: {\n    status: \"failed\",\n    date: failedDate,\n    reason: \"orders API request failed\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
