    {
      "parameters": {
        "jsCode": "const dates = $input.all();\n\n// Reports already stored by the mock API\nconst existingReports =\n  $('Get existing reports').first().json.data || [];\n\nreturn dates.map(item => {\n  const date = item.json.date;\n\n  const exists = existingReports.some(\n    report => report.date === date\n  );\n\n  return {\n    json: {\n      date,\n      exists\n    }\n  };\n});"
      },
