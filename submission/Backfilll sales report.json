      "id": "d89449ef-5118-4fa0-8440-28165110454d",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(item => item.json);\n\nconst filled = [];\nconst skipped = [];\nconst failed = [];\n\nfor (const result of results) {\n\n  if (result.status === 'filled') {\n    filled.push(result.date);\n  }\n\n  if (result.status === 'skipped') {\n    skipped.push({\n      date: result.date,\n      reason: result.reason\n    });\n  }\n\n  if (result.status === 'failed') {\n    failed.push({\n      date: result.date,\n      reason: result.reason\n    });\n  }\n\n}\n\nreturn [{\n  json: {\n    filled,\n    skipped,\n    failed\n  }\n}];"
      },
