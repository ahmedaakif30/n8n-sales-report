    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const date = item.json.date;\n\n  // Midnight in Kuala Lumpur is UTC+8\n  const start = new Date(`${date}T00:00:00+08:00`);\n\n  const from = start.toISOString();\n  const to = new Date(\n    start.getTime() + 24 * 60 * 60 * 1000\n  ).toISOString();\n\n  return {\n    json: {\n      date,\n      from,\n      to\n    }\n  };\n});"
      },
