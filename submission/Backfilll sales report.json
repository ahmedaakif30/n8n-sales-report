      "id": "10ff2565-97a4-40ac-9734-8117211b0104",
      "name": "get rates",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Get every order page that was fetched\nconst pages = $('get all orders').all();\n\n// Combine all orders from all pages\nconst orders = [];\n\nfor (const page of pages) {\n  orders.push(...page.json.data);\n}\n\n// Rates come from the current input\nconst rates = $input.first().json.rates;\n\nlet totalMyr = 0;\n\nfor (const order of orders) {\n  const rate = rates[order.currency];\n\n  if (rate === undefined) {\n    throw new Error(`Missing exchange rate for ${order.currency}`);\n  }\n\n  totalMyr += order.amount * rate;\n}\n\n// Get the date from the page request node\nconst date = $('Create page requests').first().json.date;\n\nreturn [{\n  json: {\n    date,\n    order_count: orders.length,\n    total_myr: Math.round(totalMyr * 100) / 100\n  }\n}];"
      },
