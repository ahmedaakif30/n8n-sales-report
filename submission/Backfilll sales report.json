      "name": "Webhook",
      "webhookId": "3aad94bd-ce0f-4345-8ee8-ce8ebc8a015e"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\n\nconst from = body.from;\nconst to = body.to;\n\nconst [fromYear, fromMonth, fromDay] = from.split('-').map(Number);\nconst [toYear, toMonth, toDay] = to.split('-').map(Number);\n\nlet current = new Date(Date.UTC(fromYear, fromMonth - 1, fromDay));\nconst end = new Date(Date.UTC(toYear, toMonth - 1, toDay));\n\nconst dates = [];\n\nwhile (current <= end) {\n  dates.push({\n    json: {\n      date: current.toISOString().slice(0, 10)\n    }\n  });\n\n  current.setUTCDate(current.getUTCDate() + 1);\n}\n\nreturn dates;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        192
      ],
      "id": "610ec292-318e-4d69-b0a5-a47379b83f2a",
      "name": "genrate dates"
