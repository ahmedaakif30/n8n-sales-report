    {
      "parameters": {
        "jsCode": "const firstPage = $input.first().json;\n\n// Recover the date + boundaries from the matching input item\nconst source = $('Prepare missing day').item.json;\n\nconst pages = [];\n\nfor (let page = 1; page <= firstPage.total_pages; page++) {\n  pages.push({\n    json: {\n      date: source.date,\n      from: source.from,\n      to: source.to,\n      page\n    }\n  });\n}\n\nreturn pages;"
      },
